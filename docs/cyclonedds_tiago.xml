<?xml version="1.0" encoding="UTF-8"?>
<!-- Cyclone DDS config from the lab's TIAGo Pro startup notes (Tiago_Startup.pdf, page 3-4).
     wg0 is the robot's WireGuard interface; 172.25.30.1 is the robot-side peer. Use it on L2 with
     CYCLONEDDS_URI=file:///home/user/tiago_ws/docs/cyclonedds_tiago.xml only if pal_connect.sh
     does not already set up the connection. -->
<CycloneDDS>
  <Domain>
    <General>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>1400B</MaxMessageSize>
      <Interfaces>
        <NetworkInterface name="wg0" priority="1" presence_required="false"/>
        <NetworkInterface name="lo" priority="0"/>
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer Address="localhost"/>
        <Peer Address="172.25.30.1"/>
      </Peers>
      <MaxAutoParticipantIndex>500</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <Watermarks>
        <WhcHigh>2000kB</WhcHigh>
      </Watermarks>
    </Internal>
    <Tracing>
      <Verbosity>none</Verbosity>
      <Category>config</Category>
      <OutputFile>${HOME}/.ros/log/cdds.log</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
